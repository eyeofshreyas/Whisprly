# Groq cloud transcription API key (optional — skip to use the local Docker fallback instead)
# Get a free key at https://console.groq.com
GROQ_API=gsk_your_key_here

# Google OAuth "Desktop app" credentials (optional — only needed for Google sign-in)
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# Firebase web config (optional — only needed for Firebase-backed features; baked in at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
