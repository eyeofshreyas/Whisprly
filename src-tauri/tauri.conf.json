{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisprly",
  "version": "0.2.0",
  "identifier": "com.whisprly.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whisprly",
        "width": 620,
        "height": 700,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "",
        "url": "/?window=overlay",
        "width": 90,
        "height": 30,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
