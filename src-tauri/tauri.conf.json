{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WisperFlow",
  "version": "0.1.0",
  "identifier": "com.wisperflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WisperFlow",
        "width": 480,
        "height": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
